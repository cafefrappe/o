# GitHub PAT（classic: repo 权限；或 fine-grained: 对该仓库 Contents 可写/可触发 workflows）
# 仅放在 VPS 的 .env，不要提交
GH_DISPATCH_TOKEN=ghp_xxxxxxxx

# 可选：仓库 owner/name
# GITHUB_REPO=cafefrappe/o

# PushDeer 密钥放在 GitHub Actions Secrets：PUSHDEER_KEY
# （不要放进公开仓库）

# 可选：本机直推时才需要（海外 VPS 通常连不上）
# PUSHDEER_KEY=PDU_YOUR_KEY_HERE
# NOTIFY_TITLE="甲骨文 VPS 状态"
